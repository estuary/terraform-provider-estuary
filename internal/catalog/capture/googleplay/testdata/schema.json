        "description": "The bucket containing your Google Play data. The bucket starts with pubsite_prod. For example, pubsite_prod_<some_identifier>.",
        "title": "Bucket",
        "type": "string"
      },
      "credentials": {
        "discriminator": {
          "mapping": {
            "Google Service Account": "#/$defs/GoogleServiceAccount"
          },
          "propertyName": "credentials_title"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/GoogleServiceAccount"
          }
        ],
        "title": "Authentication"
      },
      "start_date": {
        "description": "UTC date and time in the format YYYY-MM-DDTHH:MM:SSZ. Any data generated before this date will not be replicated. If left blank, the start date will be set to 30 days before the present.",
        "format": "date-time",
        "title": "Start Date",
        "type": "string"
      }
    },
    "required": [
      "bucket",
      "credentials"
    ],
    "title": "EndpointConfig",
    "type": "object"
  },
  "resource": {
    "additionalProperties": false,
    "description": "ResourceConfig is a common resource configuration shape.",
    "properties": {
