            "order": 0,
            "title": "Credentials Title",
            "type": "string"
          },
          "service_account": {
            "description": "Service account JSON key",
            "multiline": true,
            "order": 1,
            "secret": true,
            "title": "Google Service Account",
            "type": "string"
          }
        },
        "required": [
          "service_account"
        ],
        "title": "GoogleServiceAccount",
        "type": "object"
      }
    },
    "properties": {
