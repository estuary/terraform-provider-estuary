{
  "endpoint": {
    "$defs": {
      "Advanced": {
        "properties": {
          "window_size": {
            "description": "How much time a single incremental query covers when the connector sweeps for changes. Typically left as the default unless Estuary Support or the connector logs indicate otherwise.",
            "discriminator": {
              "mapping": {
                "days": "#/$defs/WindowSizeInDays",
                "interval": "#/$defs/WindowSizeAsInterval"
              },
              "propertyName": "window_type"
            },
            "nonsensitive": true,
            "oneOf": [
              {
                "$ref": "#/$defs/WindowSizeAsInterval"
              },
              {
                "$ref": "#/$defs/WindowSizeInDays"
              }
            ],
            "title": "Incremental Query Window Size"
          }
        },
        "title": "Advanced",
        "type": "object"
      },
      "SalesforceClientCredentials": {
        "properties": {
          "client_id": {
            "description": "The Consumer Key of the Connected App or External Client App.",
            "order": 1,
            "secret": true,
            "title": "Consumer Key",
            "type": "string"
          },
          "client_secret": {
            "description": "The Consumer Secret of the Connected App or External Client App.",
            "order": 2,
            "secret": true,
            "title": "Consumer Secret",
            "type": "string"
          },
          "credentials_title": {
            "const": "Client Credentials",
            "default": "Client Credentials",
            "order": 0,
            "title": "Credentials Title",
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "client_secret"
        ],
        "title": "Client Credentials",
        "type": "object"
      },
      "UserPass": {
        "properties": {
          "credentials_title": {
            "const": "Username, Password, & Security Token",
            "default": "Username, Password, & Security Token",
            "order": 0,
            "title": "Credentials Title",
            "type": "string"
          },
          "password": {
            "order": 2,
            "secret": true,
            "title": "Password",
            "type": "string"
          },
          "security_token": {
            "order": 3,
            "secret": true,
            "title": "Security Token",
            "type": "string"
          },
          "username": {
            "order": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password",
          "security_token"
        ],
        "title": "UserPass",
        "type": "object"
      },
      "WindowSizeAsInterval": {
        "properties": {
          "interval": {
            "description": "Size of the date window each incremental query covers, as an ISO 8601 duration, e.g. PT1H for one hour.",
            "format": "duration",
            "nonsensitive": true,
            "order": 1,
            "title": "Duration",
            "type": "string"
          },
          "window_type": {
            "const": "interval",
            "default": "interval",
            "nonsensitive": true,
            "order": 0,
            "title": "Window Type",
            "type": "string"
          }
        },
        "required": [
          "interval"
        ],
        "title": "Duration",
        "type": "object"
      },
      "WindowSizeInDays": {
        "properties": {
          "days": {
            "description": "Size of the date window each incremental query covers, in whole days.",
            "exclusiveMinimum": 0,
            "order": 1,
            "title": "Days",
            "type": "integer"
          },
          "window_type": {
            "const": "days",
            "default": "days",
            "nonsensitive": true,
            "order": 0,
            "title": "Window Type",
            "type": "string"
          }
        },
        "required": [
          "days"
        ],
        "title": "Days",
        "type": "object"
      },
      "_OAuth2Credentials": {
        "properties": {
          "client_id": {
            "secret": true,
            "title": "Client Id",
            "type": "string"
          },
          "client_secret": {
            "secret": true,
            "title": "Client Secret",
            "type": "string"
          },
          "credentials_title": {
            "const": "OAuth Credentials",
            "default": "OAuth Credentials",
            "title": "Credentials Title",
            "type": "string"
          },
          "instance_url": {
            "title": "Instance URL",
            "type": "string"
          },
          "refresh_token": {
            "secret": true,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "client_secret",
          "refresh_token",
          "instance_url"
        ],
        "title": "OAuth",
        "type": "object",
        "x-oauth2-provider": "salesforce"
      }
    },
    "properties": {
      "advanced": {
        "$ref": "#/$defs/Advanced",
        "advanced": true,
        "description": "Advanced settings for the connector.",
        "title": "Advanced Config"
      },
      "credentials": {
        "discriminator": {
          "mapping": {
            "Client Credentials": "#/$defs/SalesforceClientCredentials",
            "OAuth Credentials": "#/$defs/_OAuth2Credentials",
            "Username, Password, & Security Token": "#/$defs/UserPass"
          },
          "propertyName": "credentials_title"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/_OAuth2Credentials"
          },
          {
            "$ref": "#/$defs/SalesforceClientCredentials"
          }
        ],
        "title": "Authentication"
      },
      "is_sandbox": {
        "default": false,
        "description": "Toggle if you're using a Salesforce Sandbox.",
        "title": "Sandbox",
        "type": "boolean"
      },
      "my_domain": {
        "default": "",
        "description": "Your Salesforce My Domain login host. Enter the full host ending in .my.salesforce.com to login with your My Domain host. e.g. mycompany.my.salesforce.com, acme--uat.sandbox.my.salesforce.com. Leave blank to log in via the standard login/test endpoint. Required when authenticating with Client Credentials.",
        "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9.-]*\\.my\\.salesforce\\.com$",
        "title": "My Domain",
        "type": "string"
      },
      "start_date": {
        "description": "UTC date and time in the format YYYY-MM-DDTHH:MM:SSZ. Any data generated before this date will not be replicated. If left blank, the start date will be set to Salesforce's founding date (1999-02-03T00:00:00Z).",
        "format": "date-time",
        "title": "Start Date",
        "type": "string"
      }
    },
    "required": [
      "credentials"
    ],
    "title": "EndpointConfig",
    "type": "object"
  },
  "resource": {
    "additionalProperties": false,
    "properties": {
      "_meta": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Meta"
      },
      "interval": {
        "default": "PT0S",
        "description": "Interval between updates for this resource",
        "format": "duration",
        "nonsensitive": true,
        "title": "Interval",
        "type": "string"
      },
      "name": {
        "description": "Name of this resource",
        "title": "Name",
        "type": "string"
      },
      "schedule": {
        "default": "",
        "description": "Schedule to automatically refresh formula fields. Accepts a cron expression.",
        "nonsensitive": true,
        "pattern": "^((?:[0-5]?\\d(?:-[0-5]?\\d)?|\\*(?:/[0-5]?\\d)?)(?:,(?:[0-5]?\\d(?:-[0-5]?\\d)?|\\*(?:/[0-5]?\\d)?))*)\\s+((?:[01]?\\d|2[0-3]|(?:[01]?\\d|2[0-3])-(?:[01]?\\d|2[0-3])|\\*(?:/[01]?\\d|/2[0-3])?)(?:,(?:[01]?\\d|2[0-3]|(?:[01]?\\d|2[0-3])-(?:[01]?\\d|2[0-3])|\\*(?:/[01]?\\d|/2[0-3])?))*)\\s+((?:0?[1-9]|[12]\\d|3[01]|(?:0?[1-9]|[12]\\d|3[01])-(?:0?[1-9]|[12]\\d|3[01])|\\*(?:/[0-9]|/1[0-9]|/2[0-9]|/3[01])?)(?:,(?:0?[1-9]|[12]\\d|3[01]|(?:0?[1-9]|[12]\\d|3[01])-(?:0?[1-9]|[12]\\d|3[01])|\\*(?:/[0-9]|/1[0-9]|/2[0-9]|/3[01])?))*)\\s+((?:[1-9]|1[0-2]|(?:[1-9]|1[0-2])-(?:[1-9]|1[0-2])|\\*(?:/[1-9]|/1[0-2])?)(?:,(?:[1-9]|1[0-2]|(?:[1-9]|1[0-2])-(?:[1-9]|1[0-2])|\\*(?:/[1-9]|/1[0-2])?))*)\\s+((?:[0-6]|(?:[0-6])-(?:[0-6])|\\*(?:/[0-6])?)(?:,(?:[0-6]|(?:[0-6])-(?:[0-6])|\\*(?:/[0-6])?))*)$|^$",
        "title": "Formula Field Refresh Schedule",
        "type": "string"
      }
    },
    "required": [
      "name"
    ],
    "title": "SalesforceResourceConfigWithSchedule",
    "type": "object"
  }
}
