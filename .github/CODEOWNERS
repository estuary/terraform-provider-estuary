# Changes to these files can let a vulnerable dependency ship, either by adding
# an exception or by weakening or disabling the Dependency Scan, so they need
# operations' approval. This file is listed too, so the ownership itself
# cannot be removed without that approval.
/.trivyignore.yaml                        @estuary/operations
/trivy.yaml                               @estuary/operations
/.github/workflows/dependency-scan.yaml   @estuary/operations
/.github/CODEOWNERS                       @estuary/operations

# The release pipeline builds and signs the provider that the Terraform Registry
# serves, so changes to it need operations' approval too.
/.github/workflows/release.yaml           @estuary/operations
/.goreleaser.yaml                         @estuary/operations
/.github/actions/                         @estuary/operations
