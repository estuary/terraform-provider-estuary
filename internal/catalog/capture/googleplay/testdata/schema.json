        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Meta"
      },
      "interval": {
        "default": "PT0S",
        "description": "Interval between updates for this resource",
        "format": "duration",
        "nonsensitive": true,
        "title": "Interval",
        "type": "string"
      },
      "name": {
        "description": "Name of this resource",
        "title": "Name",
        "type": "string"
      }
